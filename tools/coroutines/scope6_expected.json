{
  "normal_reply_wins": [
    "pause 1 enter outer@300000 body null",
    "accept 1 value=None",
    "pause 2 operation outer@300000 body [\"reserve\",\"seat\"]",
    "accept 2 value=H",
    "pause 3 operation outer@300000 body [\"use\",\"H\"]",
    "reject 2 value",
    "accept 3 value=used",
    "pause 4 operation outer@300000 cleanup [\"release\",\"H\"]",
    "reject 3 cancel",
    "accept 4 value=None",
    "pause 5 exit outer@300000 cleanup {\"pending\":null,\"failures\":[]}",
    "accept 5 value=None",
    "terminal value=used",
    "reject 5 value"
  ],
  "alarm_wins": [
    "pause 1 enter outer@300000 body null",
    "reject-control 1 cancel",
    "accept 1 value=None",
    "pause 2 operation outer@300000 body [\"reserve\",\"seat\"]",
    "accept 2 value=H",
    "pause 3 operation outer@300000 body [\"use\",\"H\"]",
    "accept 3 cancel=cancel:alarm",
    "pause 4 operation outer@300000 cleanup [\"release\",\"H\"]",
    "reject 3 value",
    "coalesce 4 cancel",
    "accept 4 value=None",
    "pause 5 exit outer@300000 cleanup {\"pending\":\"cancel:alarm\",\"failures\":[]}",
    "accept 5 value=None",
    "terminal error=cancel:alarm"
  ],
  "nested_cancel": [
    "pause 1 enter outer@300000 body null",
    "accept 1 value=None",
    "pause 2 enter outer@300000/inner@120000 body null",
    "accept 2 value=None",
    "pause 3 operation outer@300000/inner@120000 body [\"reserve\",\"seat\"]",
    "accept 3 value=H",
    "pause 4 operation outer@300000/inner@120000 body [\"use\",\"H\"]",
    "accept 4 cancel=cancel:alarm",
    "pause 5 operation outer@300000/inner@120000 cleanup [\"release\",\"H\"]",
    "accept 5 value=None",
    "pause 6 exit outer@300000/inner@120000 cleanup {\"pending\":\"cancel:alarm\",\"failures\":[]}",
    "accept 6 value=None",
    "pause 7 operation outer@300000 cleanup [\"release\",\"outer-hold\"]",
    "accept 7 value=None",
    "pause 8 exit outer@300000 cleanup {\"pending\":\"cancel:alarm\",\"failures\":[]}",
    "accept 8 value=None",
    "terminal error=cancel:alarm"
  ],
  "cleanup_failure": [
    "pause 1 enter outer@300000 body null",
    "accept 1 value=None",
    "pause 2 operation outer@300000 body [\"reserve\",\"seat\"]",
    "accept 2 value=H",
    "pause 3 operation outer@300000 body [\"use\",\"H\"]",
    "accept 3 cancel=cancel:alarm",
    "pause 4 operation outer@300000 cleanup [\"release\",\"H\"]",
    "accept 4 error=release-failed",
    "pause 5 exit outer@300000 cleanup {\"pending\":\"cancel:alarm\",\"failures\":[\"release-failed\"]}",
    "accept 5 value=None",
    "terminal error=cleanup:['release-failed']; prior:cancel:alarm"
  ],
  "cancel_before_acquire": [
    "pause 1 enter outer@300000 body null",
    "accept 1 value=None",
    "pause 2 operation outer@300000 body [\"reserve\",\"seat\"]",
    "accept 2 cancel=cancel:alarm",
    "pause 3 exit outer@300000 cleanup {\"pending\":\"cancel:alarm\",\"failures\":[]}",
    "reject 2 value",
    "accept 3 value=None",
